# MongoDB connection URI (server-side only; never prefix with VITE_)
MONGODB_URI=
MONGODB_DB=worthgrid-db
# Generate a random secret with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters.
JWT_SECRET=
# Generate a 32-byte key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Losing or changing this key makes saved broker connections unreadable; users must reconnect.
ENCRYPTION_KEY=
# Protects the daily sync endpoint. Vercel Cron uses this value when calling the endpoint.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
